-- Mute all sounds dynamically with exceptions (safe version)
local function muteAllSounds(exceptions)
	exceptions = exceptions or {}
	local function muteContainer(container)
		if not container or not container.GetDescendants then
			return
		end
		for _, obj in pairs(container:GetDescendants()) do
			if obj and obj:IsA("Sound") and not table.find(exceptions, obj) then
				pcall(function() obj.Volume = 0 end)
			end
		end
	end

	local containers = {
		workspace,
		SoundService,
		game:GetService("ServerStorage"),
		game:GetService("ReplicatedStorage"),
		game:GetService("Lighting"),
		game:GetService("StarterGui"),
		game:GetService("StarterPack"),
		game:GetService("Players"),
	}

	for _, container in pairs(containers) do
		pcall(function() muteContainer(container) end)
	end

	for _, pl in pairs(Players:GetPlayers()) do
		pcall(function()
			if pl.Character then muteContainer(pl.Character) end
			if pl:FindFirstChild("Backpack") then muteContainer(pl.Backpack) end
		end)
	end
end

-- continuous mute thread using activeExceptions table
local activeExceptions = {}
local active = true
task.spawn(function()
	while active do
		muteAllSounds(activeExceptions)
		task.wait(0.45)
	end
end)

-- helper to add/remove exception sound objects
local function addException(snd)
	if not snd then return end
	if not table.find(activeExceptions, snd) then
		table.insert(activeExceptions, snd)
	end
end
local function removeException(snd)
	if not snd then return end
	local idx = table.find(activeExceptions, snd)
	if idx then table.remove(activeExceptions, idx) end
end


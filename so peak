-- Play sound helper
local function playSound(id, looped, parent)
	parent = parent or workspace
	local success, s = pcall(function()
		local snd = Instance.new("Sound")
		snd.SoundId = "rbxassetid://"..tostring(id)
		snd.Looped = looped or false
		snd.Volume = 1
		snd.Parent = parent
		snd:Play()
		return snd
	end)
	if success then
		return s
	else
		return nil
	end
end

